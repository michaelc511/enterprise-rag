# Copy to .env (gitignored) and fill in one provider.
OPENAI_API_KEY=

# Or Azure OpenAI (used only when OPENAI_API_KEY is empty):
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_LLM_DEPLOYMENT=gpt-4o-mini
# AZURE_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small

# Optional overrides (defaults shown)
# USE_CASE=vendor-risk-compliance
# LLM_MODEL=gpt-4o-mini
# EMBEDDINGS_MODEL=text-embedding-3-small
